{
  "data": {
    "root": "data",
    "manifest": "artifacts/pb2_pairs.json",
    "expected_product": "pb",
    "max_delta_seconds": 15.0,
    "crop_size": null,
    "batch_size": 1,
    "num_workers": 1,
    "pin_memory": true,
    "train_fraction": 0.8,
    "validation_fraction": 0.1,
    "seed": 17
  },
  "model": {
    "name": "tf_hdn_v2",
    "channels": [32, 64, 128, 256],
    "blocks_per_level": 2,
    "group_norm_groups": 8,
    "maximum_offset_pixels": 4.0,
    "input_scale": 1e-8,
    "minimum_noise_scale": 1e-10,
    "positional_grid_size": 32,
    "time_scale_seconds": 15.0,
    "log_component_limit": 12.0
  },
  "loss": {
    "observation_weight": 1.0,
    "normalization_bandwidth_weight": 0.001,
    "noise_independence_weight": 0.001,
    "common_consistency_weight": 0.01,
    "radial_flatness_weight": 0.05,
    "gauge_weight": 0.01,
    "radial_bins": 32,
    "cme_weight": 0.0
  },
  "train": {
    "epochs": 100,
    "learning_rate": 0.0002,
    "weight_decay": 0.0001,
    "minimum_learning_rate": 0.000001,
    "gradient_clip": 1.0,
    "mixed_precision": false,
    "mask_fraction": 0.05,
    "mask_patch_size": 8,
    "frame_drop_probability": 0.0,
    "device": "cuda",
    "output_dir": "artifacts/training_v2",
    "resume_checkpoint": null,
    "log_every_steps": 25,
    "progress_bar": true,
    "minimum_normalization_log_std": 0.001,
    "maximum_log_saturation_fraction": 0.001
  }
}
